{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dwarak-site-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "../../admin-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "ANALYTICS_DATASET": "dwarak_site_events"
  },
  "routes": [
    {
      "pattern": "admin.dwarakfoundations.com",
      "custom_domain": true
    }
  ]
}
