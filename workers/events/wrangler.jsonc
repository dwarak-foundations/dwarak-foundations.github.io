{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dwarak-site-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "dwarak_site_events"
    }
  ],
  "routes": [
    {
      "pattern": "dwarakfoundations.com/api/events",
      "zone_name": "dwarakfoundations.com"
    }
  ]
}
