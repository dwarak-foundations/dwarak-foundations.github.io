---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactBand from "@/components/ContactBand.astro";
---

<BaseLayout
  title="About"
  description="Learn about Dwarak Foundations Chennai LLP, a client-focused Chennai construction company established by Varadharajan Ramasamy in 1998."
>
  <header class="page-hero">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="page-title">About Dwarak Foundations.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Building homes in Chennai since 1998.
        </p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="about-lead shell">
      <figure class="about-portrait" data-reveal>
        <img
          src="/img/team/profile-picture-1.jpg"
          width="900"
          height="1125"
          alt="Mr. Varadharajan Ramasamy, designated partner at Dwarak Foundations"
        />
        <figcaption class="about-portrait__caption">
          <span>Mr. Varadharajan Ramasamy</span><span>Designated Partner</span>
        </figcaption>
      </figure>
      <div class="about-copy" data-reveal>
        <p class="eyebrow">Dwarak Foundations Chennai LLP</p>
        <h2>50+ projects since 1998.</h2>
        <p>
          Led by Mr. Varadharajan Ramasamy, we build villas, duplex homes, and apartment buildings across Chennai.
        </p>
        <dl class="company-details" aria-label="Company registration details">
          <div><dt>Founded</dt><dd>1998</dd></div>
          <div><dt>LLPIN</dt><dd>AAC-4780</dd></div>
          <div><dt>GSTIN</dt><dd>33AAKFD4944Q2ZV</dd></div>
          <div><dt>RoC</dt><dd>RoC-Chennai</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Our work</p>
        <h2>What we build.</h2>
      </div>
      <div class="milestone-grid" data-reveal>
        <div><strong>08</strong><p>Villas</p></div>
        <div><strong>18</strong><p>Duplex homes</p></div>
        <div><strong>27</strong><p>Apartment buildings</p></div>
      </div>
    </div>
  </section>

  <ContactBand />
</BaseLayout>
