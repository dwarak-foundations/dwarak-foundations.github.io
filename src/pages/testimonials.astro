---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactBand from "@/components/ContactBand.astro";
import QuoteCard from "@/components/QuoteCard.astro";
import { byOrder } from "@/lib/content";

const testimonials = (await getCollection("testimonials")).sort(byOrder);
---

<BaseLayout
  title="Client Stories"
  description="Read what homeowners and development partners say about working with Dwarak Foundations in Chennai."
>
  <header class="page-hero">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">Client stories</p>
        <h1 class="page-title">What our clients say.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Their experience, in their words.
        </p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="quotes-grid quotes-grid--masonry shell">
      {testimonials.map((testimonial, index) => <QuoteCard testimonial={testimonial} index={index} />)}
    </div>
  </section>

  <ContactBand />
</BaseLayout>
