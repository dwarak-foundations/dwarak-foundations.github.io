---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsExplorer from "@/components/ProjectsExplorer.astro";
import { byOrder } from "@/lib/content";

const projects = (await getCollection("projects")).sort(byOrder);
---

<BaseLayout
  title="Dwarak Foundations"
  description="See completed, ongoing, and upcoming Dwarak Foundations projects across Chennai."
  hideFooter
>
  <ProjectsExplorer projects={projects} fullBleed />
</BaseLayout>
