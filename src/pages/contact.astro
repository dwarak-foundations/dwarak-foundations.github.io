---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { whatsappDisplayNumber, whatsappHref } from "@/lib/contact";

const mapEmbed = "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d497732.60109624936!2d80.209528!3d12.93752!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a525c35fe591a77%3A0xc76595f0e7d9138b!2sArumugam%20Nagar%20I%20St%2C%20Pallikaranai%2C%20Chennai%2C%20Tamil%20Nadu%20600100%2C%20India!5e0!3m2!1sen!2sus!4v1636088923209!5m2!1sen!2sus";
const whatsappUrl = whatsappHref("Hello, I would like to know more about Dwarak Foundations.");
---

<BaseLayout
  title="WhatsApp"
  description="Message Dwarak Foundations on WhatsApp about a home or construction project in Chennai."
>
  <header class="page-hero">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">Dwarak Foundations</p>
        <h1 class="page-title">WhatsApp us.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Tell us what you want to build.
        </p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="contact-grid shell">
      <div data-reveal>
        <div class="contact-list">
          <div class="contact-item">
            <span>WhatsApp</span>
            <div>
              <a class="button button--whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_clicked" data-analytics-target="contact_primary">
                {whatsappDisplayNumber} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="contact-item">
            <span>Visit</span>
            <address>
              Plot No. 11A, Ground Floor<br />
              Arumugam Nagar 1st Street<br />
              IIT Colony Main Road<br />
              Pallikaranai, Chennai 600100
            </address>
          </div>
          <div class="contact-item">
            <span>Hours</span>
            <div>Monday to Saturday<br />9:30 am to 6:00 pm</div>
          </div>
        </div>
      </div>
      <div class="map-frame contact-aside" data-reveal>
        <iframe
          src={mapEmbed}
          title="Map showing the Dwarak Foundations office in Pallikaranai"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
