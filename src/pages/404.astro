---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="not-found shell">
    <div>
      <strong>404</strong>
      <h1>Page not found.</h1>
      <p>Check the address or return to our projects.</p>
      <a class="button" href="/">View projects <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
