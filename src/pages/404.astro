---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="not-found shell">
    <div>
      <strong>404</strong>
      <h1>This plan leads elsewhere.</h1>
      <p>The page may have moved, or the address may be incomplete.</p>
      <a class="button" href="/">Return home <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
