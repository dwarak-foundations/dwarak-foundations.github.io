---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactBand from "@/components/ContactBand.astro";
import ProjectsExplorer from "@/components/ProjectsExplorer.astro";
import { byOrder } from "@/lib/content";

const projects = (await getCollection("projects")).sort(byOrder);
---

<BaseLayout
  title="Projects"
  description="Explore completed and ongoing residential buildings, individual homes, and future opportunities by Dwarak Foundations across Chennai."
>
  <header class="page-hero">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">Our portfolio</p>
        <h1 class="page-title">Places made to be lived in.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Explore completed homes, current work, and future opportunities across Chennai by map or list.
        </p>
      </div>
    </div>
  </header>

  <ProjectsExplorer projects={projects} />

  <ContactBand />
</BaseLayout>
