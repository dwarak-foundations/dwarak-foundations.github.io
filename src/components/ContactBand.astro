---
import { whatsappHref } from "@/lib/contact";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";

const href = whatsappHref("Hello, I would like to discuss a project with Dwarak Foundations.");
---

<section class="contact-band">
  <div class="shell contact-band__inner" data-reveal>
    <div>
      <p class="eyebrow">Start here</p>
      <h2>Planning a home?</h2>
    </div>
    <p>Message us about your home or land.</p>
    <a class="button button--light button--whatsapp" href={href} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_clicked" data-analytics-target="contact_band">
      <span class="button__label"><WhatsAppIcon />Contact us</span><span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
