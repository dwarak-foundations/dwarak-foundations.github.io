---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
  align?: "left" | "center";
}

const { eyebrow, title, copy, align = "left" } = Astro.props;
---

<div class:list={["section-heading", align === "center" && "section-heading--center"]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {copy && <p class="section-heading__copy">{copy}</p>}
</div>
