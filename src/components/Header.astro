---
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import { whatsappHref } from "@/lib/contact";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const links = [
  { href: "/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/testimonials/", label: "Stories" },
  { href: "/contact/", label: "Contact" },
];
const whatsappUrl = whatsappHref("Hello, I would like to know more about Dwarak Foundations.");
const isActive = (href: string) =>
  href === "/" ? pathname === href || pathname.startsWith("/projects/") : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="Dwarak Foundations home">
      <img src="/img/brand/dark.svg" width="202" height="72" alt="Dwarak Foundations" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="button button--accent nav-whatsapp"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        data-analytics-event="whatsapp_clicked"
        data-analytics-target="header"
      >
        <span class="button__label"><WhatsAppIcon />WhatsApp</span>
      </a>

      <button
        class="language-toggle"
        type="button"
        data-locale-toggle
        data-locale-target="ta"
        data-i18n-ignore
        aria-label="Switch to Tamil"
      >
        <span class="language-toggle__mark" data-locale-toggle-mark aria-hidden="true">ஆ</span>
        <span data-locale-toggle-label lang="ta">தமிழ்</span>
      </button>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span><span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
